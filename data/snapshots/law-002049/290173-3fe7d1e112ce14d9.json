          "부칙내용": [
            [
              "부칙",
              "이 영은 2008년 12월 22일부터 시행한다."
            ]
          ],
          "부칙키": "2008102921094"
        },
        {
          "부칙공포번호": "22151",
          "부칙공포일자": "20100504",
          "부칙내용": [
            [
              "부칙(전자정부법 시행령)",
              "제1조(시행일) 이 영은 2010년 5월 5일부터 시행한다.",
              "제2조 및 제3조 생략",
              "제4조(다른 법령의 개정) ① 부터 ⑥ 까지 생략",
              "⑦ 가석방자관리규정 일부를 다음과 같이 개정한다.",
              "제13조제1항 각 호 외의 부분 후단 및 별지 제3호서식 중 \"「전자정부법」 제21조제1항\"을 각각 \"「전자정부법」 제36조제1항\"으로 한다.",
              "⑧ 부터  까지 생략"
            ]
          ],
          "부칙키": "2010050422151"
        },
        {
          "부칙공포번호": "26921",
          "부칙공포일자": "20160122",
          "부칙내용": [
            [
              "부칙",
              "제1조(시행일) 이 영은 공포한 날부터 시행한다.",
              "제2조(국내주거지 이전등 또는 국외 이주등의 허가에 관한 경과조치) 이 영 시행 당시 종전의 규정에 따라 국내주거지 이전등 또는 국외 이주등에 관한 허가를 받은 사람이나 허가신청서를 제출하여 허가 절차가 진행 중인 사람은 제10조 또는 제13조의 개정규정에 따라 신고한 것으로 본다."
            ]
          ],
          "부칙키": "2016012226921"
        },
        {
          "부칙공포번호": "28016",
          "부칙공포일자": "20170508",
          "부칙내용": [
            [
              "부칙",
              "이 영은 공포한 날부터 시행한다."
            ]
          ],
          "부칙키": "2017050828016"
        },
        {
          "부칙공포번호": "32737",
          "부칙공포일자": "20220630",
          "부칙내용": [
            [
              "부칙(군검찰사무 운영규정)",
              "제1조(시행일) 이 영은 2022년 7월 1일부터 시행한다.",
              "제2조(다른 법령의 개정) ① 가석방자관리규정 일부를 다음과 같이 개정한다.",
              "제21조 중 \"검찰관이\"를 \"군검사가\"로 한다.",
              "②부터 ⑪까지 생략"
            ]
          ],
          "부칙키": "2022063032737"
        },
        {
          "부칙공포번호": "36728",
          "부칙공포일자": "20260929",
          "부칙내용": [
            [
              "부칙(「공소청법」 및 「중대범죄수사청 조직 및 운영에 관한 법률」의 제정과 「형사소송법」 개정에 따른 관계 법령의 정비를 위한 126개 법령의 일부개정에 관한 대통령령)",
              "제1조(시행일) 이 영은 2026년 10월 2일부터 시행한다.",
              "제2조부터 제4조까지 생략"
            ]
          ],
          "부칙키": "2026092936728"
        }
      ]
    },
    "articles": {
      "조문단위": [
        {
          "조문내용": "제1조(목적) 이 영은 가석방자에 대한 가석방 기간 중의 보호와 감독에 필요한 사항을 규정함을 목적으로 한다.",
          "조문번호": "1",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "목적",
          "조문키": "0001001"
        },
        {
          "조문내용": "제2조(정의) 이 영에서 \"가석방자\"란 징역 또는 금고 형의 집행 중에 있는 사람으로서 「형법」 제72조 및 「형의 집행 및 수용자의 처우에 관한 법률」 제122조에 따라 가석방된 사람(「보호관찰 등에 관한 법률」에 따른 보호관찰 대상자는 제외한다)을 말한다.",
          "조문번호": "2",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "정의",
          "조문키": "0002001"
        },
        {
          "조문내용": "제3조(가석방자의 보호와 감독) 가석방자는 그의 주거지를 관할하는 경찰서(경찰서의 지구대를 포함한다. 이하 같다)의 장의 보호와 감독을 받는다.",
          "조문번호": "3",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방자의 보호와 감독",
          "조문키": "0003001"
        },
        {
          "조문내용": "제4조(가석방 사실의 통보)",
          "조문번호": "4",
          "조문변경여부": "Y",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "000000",
          "조문이동이후": "000000",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방 사실의 통보",
          "조문키": "0004001",
          "항": [
            {
              "항내용": "① 교도소ㆍ구치소 및 그 지소(支所)(이하 \"교정시설\"이라 한다)의 장은 가석방이 허가된 사람을 석방할 때에는 그 사실을 가석방될 사람의 주거지를 관할하는 지방공소청장(지방공소청 지청장을 포함한다. 이하 같다)과 형을 선고한 법원에 대응하는 공소청의 장 및 가석방될 사람을 보호ㆍ감독할 경찰서(이하 \"관할경찰서\"라 한다)의 장에게 미리 통보하여야 한다.",
              "항번호": "①"
            },
            {
              "항내용": "② 교정시설의 장은 가석방이 허가된 사람에게 가석방의 취소 및 실효사유와 가석방자로서 지켜야 할 사항 등을 알리고, 주거지에 도착할 기한 및 관할경찰서에 출석할 기한 등을 적은 가석방증을 발급하여야 한다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제5조(가석방자의 출석의무) 가석방자는 제4조제2항에 따른 가석방증에 적힌 기한 내에 관할경찰서에 출석하여 가석방증에 출석확인을 받아야 한다. 다만, 천재지변, 질병, 그 밖의 부득이한 사유로 기한 내에 출석할 수 없거나 출석하지 아니하였을 때에는 지체 없이 그 사유를 가장 가까운 경찰서의 장에게 신고하고 별지 제1호서식의 확인서를 받아 관할경찰서의 장에게 제출하여야 한다.",
          "조문번호": "5",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방자의 출석의무",
          "조문키": "0005001"
        },
        {
          "조문내용": "제6조(가석방자의 신고의무)",
          "조문번호": "6",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방자의 신고의무",
          "조문키": "0006001",
          "항": [
            {
              "항내용": "① 가석방자는 그의 주거지에 도착하였을 때에는 지체 없이 종사할 직업 등 생활계획을 세우고 이를 관할경찰서의 장에게 서면으로 신고하여야 한다.",
              "항번호": "①"
            },
            {
              "항내용": "② 가석방자의 보호를 맡은 사람은 제1항의 신고서에 기명날인(記名捺印) 또는 서명하여야 한다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제7조(관할경찰서의 장의 조치)",
          "조문번호": "7",
          "조문변경여부": "Y",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "000000",
          "조문이동이후": "000000",
          "조문제개정유형": "타법개정",
          "조문제목": "관할경찰서의 장의 조치",
          "조문키": "0007001",
          "항": [
            {
              "항내용": "① 관할경찰서의 장은 가석방자가 가석방 기간 중 정상적인 업무에 종사하고 비행(非行)을 저지르지 아니하도록 적절한 지도를 할 수 있다.",
              "항번호": "①"
            },
            {
              "항내용": "② 관할경찰서의 장은 제1항에 따른 지도 중 가석방자의 재범방지를 위해 특히 필요하다고 인정하는 경우에는 특정 장소의 출입제한명령 등 필요한 조치를 할 수 있다.",
              "항번호": "②"
            },
            {
              "항내용": "③ 관할경찰서의 장은 제2항에 따른 조치를 할 경우 그 사실을 관할 지방공소청장 및 가석방자를 수용하였다가 석방한 교정시설(이하 \"석방시설\"이라 한다)의 장(이하 \"관계기관의 장\"이라 한다)에게 통보하여야 한다.",
              "항번호": "③"
            }
          ]
        },
        {
          "조문내용": "제8조(가석방자에 대한 조사) 관할경찰서의 장은 6개월마다 가석방자의 품행, 직업의 종류, 생활 정도, 가족과의 관계, 가족의 보호 여부 및 그 밖의 참고사항에 관하여 조사서를 작성하고 관계기관의 장에게 통보하여야 한다. 다만, 변동 사항이 없는 경우에는 그러하지 아니하다.",
          "조문번호": "8",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방자에 대한 조사",
          "조문키": "0008001"
        },
        {
          "조문내용": "제9조(보호와 감독의 위임)",
          "조문번호": "9",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "보호와 감독의 위임",
          "조문키": "0009001",
          "항": [
            {
              "항내용": "① 관할경찰서의 장은 석방시설의 장의 의견을 들어 가석방자의 보호와 감독을 적당한 사람에게 위임할 수 있다.",
              "항번호": "①"
            },
            {
              "항내용": "② 제1항에 따라 보호와 감독을 위임받은 사람은 매월 말일 제8조에서 정한 사항을 관할경찰서의 장에게 보고하여야 한다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제10조(국내 주거지 이전 및 여행)",
          "조문번호": "10",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "국내 주거지 이전 및 여행",
          "조문참고자료": "[전문개정 2016.1.22]",
          "조문키": "0010001",
          "항": [
            {
              "항내용": "① 가석방자는 국내 주거지 이전(移轉) 또는 1개월 이상 국내 여행(이하 \"국내주거지 이전등\"이라 한다)을 하려는 경우 관할경찰서의 장에게 신고하여야 한다.",
              "항번호": "①"
            },
            {
              "항내용": "② 제1항에 따른 신고를 하려는 사람은 별지 제2호서식의 신고서(전자문서로 된 신고서를 포함한다)를 관할경찰서의 장에게 제출하여야 한다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제11조(국내주거지 이전등의 신고에 따른 조치)",
          "조문번호": "11",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "국내주거지 이전등의 신고에 따른 조치",
          "조문참고자료": "[제목개정 2016.1.22]",
          "조문키": "0011001",
          "항": [
            {
              "항내용": "① 관할경찰서의 장은 가석방자가 제10조에 따라 국내주거지 이전등을 신고한 경우에는 제7조제1항 및 제2항에 따른 지도 및 조치를 하여야 한다. 다만, 관할경찰서의 관할 구역에서 주거지를 이전하거나 여행하는 경우에는 그러하지 아니하다.",
              "항번호": "①"
            },
            {
              "항내용": "② 제1항의 경우에는 제7조제3항을 준용한다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제12조(국내주거지 이전등 신고 사실의 통보) 관할경찰서의 장은 제10조에 따라 국내주거지 이전등의 신고를 받은 경우에는 가석방자의 새 주거지를 관할하는 지방공소청장 및 경찰서의 장에게 신고 사실을 통보하고, 해당 경찰서의 장에게 관계서류를 송부하여야 한다.",
          "조문번호": "12",
          "조문변경여부": "Y",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "000000",
          "조문이동이후": "000000",
          "조문제개정유형": "타법개정",
          "조문제목": "국내주거지 이전등 신고 사실의 통보",
          "조문참고자료": "[제목개정 2016.1.22]",
          "조문키": "0012001"
        },
        {
          "조문내용": "제13조(국외 이주 및 여행)",
          "조문번호": "13",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "국외 이주 및 여행",
          "조문참고자료": "[전문개정 2016.1.22]",
          "조문키": "0013001",
          "항": [
            {
              "항내용": "① 가석방자는 국외 이주 또는 1개월 이상 국외 여행(이하 \"국외 이주등\"이라 한다)을 하려는 경우 관할경찰서의 장에게 신고하여야 한다.",
              "항번호": "①"
            },
            {
              "항내용": "② 제1항에 따른 신고를 하려는 사람은 별지 제3호서식의 신고서(전자문서로 된 신고서를 포함한다)에 다음 각 호의 서류(전자문서를 포함한다)를 첨부하여 관할경찰서의 장에게 제출하여야 한다. 이 경우 담당 공무원은 「전자정부법」 제36조제1항에 따른 행정정보의 공동이용을 통하여 가석방자의 주민등록표 초본을 확인하여야 하며, 가석방자가 확인에 동의하지 아니하는 경우에는 이를 제출하도록 하여야 한다.",
              "항번호": "②",
              "호": [
                {
                  "호내용": "1. 가석방증 사본 또는 수용증명서 1부",
                  "호번호": "1."
                },
                {
                  "호내용": "2. 초청장 등 사본 1부",
                  "호번호": "2."
                },
                {
                  "호내용": "3. 귀국서약서 1부(국외여행자만 해당한다)",
                  "호번호": "3."
                }
              ]
            }
          ]
        },
        {
          "조문내용": "제14조 삭제",
          "조문번호": "14",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "",
          "조문키": "0014001"
        },
        {
          "조문내용": "제15조(국외 이주등 중지의 신고) 제13조에 따라 신고한 가석방자는 국외 이주등을 중지하였을 때에는 지체 없이 그 사실을 관할경찰서의 장에게 신고하여야 한다.",
          "조문번호": "15",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "국외 이주등 중지의 신고",
          "조문참고자료": "[제목개정 2016.1.22]",
          "조문키": "0015001"
        },
        {
          "조문내용": "제16조(국외 여행자의 귀국신고) 국외 여행을 한 가석방자는 귀국하여  주거지에 도착하였을 때에는 지체 없이 그 사실을 관할경찰서의 장에게 신고하여야 한다. 국외 이주한 가석방자가 입국하였을 때에도 또한 같다.",
          "조문번호": "16",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "국외 여행자의 귀국신고",
          "조문키": "0016001"
        },
        {
          "조문내용": "제17조(신고사항의 통보) 제13조, 제15조 및 제16조에 따른 신고를 받은 관할경찰서의 장은 그 사실을 관계기관의 장에게 통보하여야 한다.",
          "조문번호": "17",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "신고사항의 통보",
          "조문키": "0017001"
        },
        {
          "조문내용": "제18조(가석방의 실효 등 보고) 각 지방공소청장, 경찰서의 장 및 교정시설의 장은 가석방자가 「형법」 제74조 또는 제75조에 해당하게 된 사실을 알았을 때에는 지체 없이 석방시설의 장에게 통보하여야 하며, 통보를 받은 석방시설의 장은 지체 없이 법무부장관에게 보고하여야 한다.",
          "조문번호": "18",
          "조문변경여부": "Y",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "000000",
          "조문이동이후": "000000",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방의 실효 등 보고",
          "조문키": "0018001"
        },
        {
          "조문내용": "제19조(가석방의 취소 등)",
          "조문번호": "19",
          "조문변경여부": "Y",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "000000",
          "조문이동이후": "000000",
          "조문제개정유형": "타법개정",
          "조문제목": "가석방의 취소 등",
          "조문키": "0019001",
          "항": [
            {
              "항내용": "① 법무부장관은 가석방 처분을 취소하였을 때에는 가석방자의 주거지를 관할하는 지방공소청장 또는 교정시설의 장이나 가석방 취소 당시 가석방자를 수용하고 있는 교정시설의 장에게 통보하여 남은 형을 집행하게 하여야 한다.",
              "항번호": "①"
            },
            {
              "항내용": "② 제1항의 경우 제4조제2항에 따라 발급한 가석방증은 효력을 잃는다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제20조(사망 통보)",
          "조문번호": "20",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "사망 통보",
          "조문키": "0020001",
          "항": [
            {
              "항내용": "① 가석방자가 사망한 경우 관할경찰서의 장은 그 사실을 관계기관의 장에게 통보하여야 한다.",
              "항번호": "①"
            },
            {
              "항내용": "② 제1항의 통보를 받은 석방시설의 장은 그 사실을 법무부장관에게 보고하여야 한다.",
              "항번호": "②"
            }
          ]
        },
        {
          "조문내용": "제21조(준용규정) 군사법원에서 형의 선고를 받은 사람에 대한 법무부장관의 직무는 국방부장관이 수행하고, 검사의 직무는 형을 선고한 군사법원에 대응하는 군검찰부의 군검사가 수행한다.",
          "조문번호": "21",
          "조문변경여부": "N",
          "조문시행일자": "20261002",
          "조문여부": "조문",
          "조문이동이전": "",
          "조문이동이후": "",
          "조문제개정유형": "타법개정",
          "조문제목": "준용규정",
          "조문키": "0021001"
        }
      ]
    }
