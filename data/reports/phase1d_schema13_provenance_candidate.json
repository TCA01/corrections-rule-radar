{
  "$id": "urn:corrections-rule-radar:unpublished:1.3:production-provenance",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "정식 API 스키마나 freeze lock에 적용하지 않은 검토용 하위 계약. 내부 discovery 계약의 API class는 5개 전체 enum을 허용하되 공개 추적 규정 provenance는 API_TRACKABLE만 허용.",
  "properties": {
    "api_tracking_class": {
      "const": "API_TRACKABLE"
    },
    "applies_to": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "canonical_source_url": {
      "format": "uri",
      "pattern": "^https://(www\\.)?law\\.go\\.kr/LSW/",
      "type": "string"
    },
    "discovery_source": {
      "items": {
        "enum": [
          "CORRECTIONS_PAGE",
          "LAW_API_KEYWORD",
          "LAW_API_MINISTRY",
          "CORE_SYSTEM_MAP",
          "MANUAL_OFFICIAL_REVIEW"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "first_seen_at": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "last_seen_on_corrections_page": {
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "official_seed_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "official_seed_url": {
      "anyOf": [
        {
          "format": "uri",
          "pattern": "^https://www\\.corrections\\.go\\.kr/",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_class": {
      "enum": [
        "OFFICIAL_CORRECTIONS_LIST",
        "DIRECT_CORRECTIONS",
        "CROSS_DOMAIN_CORRECTIONS",
        "HISTORICAL_REPEALED"
      ]
    },
    "scope_review_status": {
      "const": "APPROVED"
    },
    "selection_basis": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "scope_class",
    "selection_basis",
    "applies_to",
    "official_seed_name",
    "official_seed_url",
    "canonical_source_url",
    "discovery_source",
    "scope_review_status",
    "api_tracking_class"
  ],
  "title": "UNPUBLISHED schema 1.3 proposed production provenance",
  "type": "object"
}
