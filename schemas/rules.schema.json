{
  "$id": "urn:corrections-rule-radar:api:v1:rules",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dataset_version": {
      "pattern": "^ds-[a-f0-9]{64}$",
      "type": "string"
    },
    "rules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "business_domains": {
            "items": {
              "enum": [
                "수용·보안",
                "접견·외부교통",
                "보관금품",
                "분류·가석방",
                "교육·교화",
                "작업·직업훈련",
                "급식·복지",
                "의료",
                "심리치료",
                "인권·청원",
                "민원",
                "인사·조직",
                "정보화",
                "민영교도소",
                "보고",
                "기타"
              ]
            },
            "type": "array"
          },
          "canonical_id": {
            "pattern": "^(law|admrul)-\\d+$",
            "type": "string"
          },
          "classification_status": {
            "enum": [
              "REVIEW",
              "REVIEWED"
            ]
          },
          "corrections_category": {
            "enum": [
              "법률",
              "대통령령",
              "법무부령",
              "예규",
              "훈령",
              "지침"
            ]
          },
          "current_name": {
            "type": "string"
          },
          "detail_url": {
            "pattern": "^/api/v1/rules/(law|admrul)-\\d+\\.json$",
            "type": "string"
          },
          "domain_assignment_status": {
            "enum": [
              "EVIDENCE_BASED",
              "FALLBACK"
            ]
          },
          "historical_names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "metadata": {
            "additionalProperties": false,
            "properties": {
              "amendment_type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "department": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "effective_date": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "issue_date": {
                "format": "date",
                "type": [
                  "string",
                  "null"
                ]
              },
              "issue_number": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ministry": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "official_state": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rule_type": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name",
              "rule_type",
              "issue_date",
              "issue_number",
              "effective_date",
              "ministry",
              "department",
              "amendment_type",
              "official_state"
            ],
            "type": "object"
          },
          "official_source_url": {
            "format": "uri",
            "pattern": "^https://(www\\.)?law\\.go\\.kr/",
            "type": "string"
          },
          "primary_domain": {
            "anyOf": [
              {
                "enum": [
                  "수용·보안",
                  "접견·외부교통",
                  "보관금품",
                  "분류·가석방",
                  "교육·교화",
                  "작업·직업훈련",
                  "급식·복지",
                  "의료",
                  "심리치료",
                  "인권·청원",
                  "민원",
                  "인사·조직",
                  "정보화",
                  "민영교도소",
                  "보고",
                  "기타"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "api_tracking_class": {
                "const": "API_TRACKABLE"
              },
              "appendix_metadata_source": {
                "const": "LAWGO_STRUCTURED_METADATA"
              },
              "applies_to": {
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "canonical_source_url": {
                "format": "uri",
                "pattern": "^https://(www\\.)?law\\.go\\.kr/",
                "type": "string"
              },
              "discovery_source": {
                "items": {
                  "enum": [
                    "CORRECTIONS_PAGE",
                    "LAW_API_KEYWORD",
                    "LAW_API_MINISTRY",
                    "CORE_SYSTEM_MAP",
                    "MANUAL_OFFICIAL_REVIEW"
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "history_source": {
                "const": "LAWGO_STRUCTURED_HISTORY"
              },
              "official_seed_name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "official_seed_url": {
                "anyOf": [
                  {
                    "format": "uri",
                    "pattern": "^https://www\\.corrections\\.go\\.kr/",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope_class": {
                "enum": [
                  "OFFICIAL_CORRECTIONS_LIST",
                  "DIRECT_CORRECTIONS",
                  "CROSS_DOMAIN_CORRECTIONS",
                  "HISTORICAL_REPEALED"
                ]
              },
              "scope_review_status": {
                "const": "APPROVED"
              },
              "selection_basis": {
                "minLength": 1,
                "type": "string"
              },
              "structured_body_source": {
                "const": "LAWGO_JSON_XML"
              }
            },
            "required": [
              "scope_class",
              "selection_basis",
              "applies_to",
              "official_seed_name",
              "official_seed_url",
              "canonical_source_url",
              "discovery_source",
              "scope_review_status",
              "api_tracking_class",
              "structured_body_source",
              "history_source",
              "appendix_metadata_source"
            ],
            "type": "object"
          },
          "secondary_domains": {
            "items": {
              "enum": [
                "수용·보안",
                "접견·외부교통",
                "보관금품",
                "분류·가석방",
                "교육·교화",
                "작업·직업훈련",
                "급식·복지",
                "의료",
                "심리치료",
                "인권·청원",
                "민원",
                "인사·조직",
                "정보화",
                "민영교도소",
                "보고",
                "기타"
              ]
            },
            "type": "array"
          },
          "seed_names": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "source_kind": {
            "enum": [
              "law",
              "admrul"
            ]
          },
          "status": {
            "enum": [
              "CURRENT",
              "REPEALED",
              "REVIEW"
            ]
          },
          "version_id": {
            "type": "string"
          }
        },
        "required": [
          "canonical_id",
          "source_kind",
          "current_name",
          "seed_names",
          "historical_names",
          "corrections_category",
          "business_domains",
          "classification_status",
          "status",
          "version_id",
          "metadata",
          "official_source_url",
          "detail_url",
          "primary_domain",
          "secondary_domains",
          "provenance",
          "domain_assignment_status"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.5"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "rules"
  ],
  "title": "rules",
  "type": "object"
}
