        ]
      },
      "articles": {
        "조문단위": [
          {
            "조문내용": "제1조(목적) 이 영은 수형자나 그 밖에 법령에 따라 구속된 사람의 호송에 필요한 사항을 규정함을 목적으로 한다.",
            "조문번호": "1",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "목적",
            "조문참고자료": "[전문개정 2015.12.10]",
            "조문키": "0001001"
          },
          {
            "조문내용": "제2조(호송공무원) 교도소ㆍ구치소 및 그 지소(이하 \"교정시설\"이라 한다) 간의 호송은 교도관이 행하며, 그 밖의 호송은 경찰관 또는 「검찰청법」 제47조에 따라 사법경찰관리로서의 직무를 수행하는 검찰청 직원이 행한다.",
            "조문번호": "2",
            "조문변경여부": "Y",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "호송공무원",
            "조문키": "0002001"
          },
          {
            "조문내용": "제3조(호송방법)",
            "조문번호": "3",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "호송방법",
            "조문키": "0003001",
            "항": [
              {
                "항내용": "①호송은 피호송자를 받아야 할 관서 또는 출두하여야 할 장소와 유치할 장소에 곧바로 호송한다.",
                "항번호": "①"
              },
              {
                "항내용": "②호송은 필요에 의하여 차례로 여러곳을 거쳐서 행할 수 있다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제4조(호송장등)",
            "조문번호": "4",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "호송장등",
            "조문키": "0004001",
            "항": [
              {
                "항내용": "①발송관서는 호송관에게 피호송자를 인도하는 동시에 별지 서식의 호송장 기타 필요한 서류를 내어주어야 한다.",
                "항번호": "①"
              },
              {
                "항내용": "②교도관이 호송하는 때에는 신분장 및 영치금품 송부서를 호송장으로 대용할 수 있다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제5조(수송관서에의 통지) 발송관서는 미리 수송관서에 대하여 피호송자의 성명ㆍ발송시일ㆍ호송사유 및 방법을 통지하여야 한다.",
            "조문번호": "5",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "수송관서에의 통지",
            "조문키": "0005001"
          },
          {
            "조문내용": "제6조(영치금품의 처리) 피호송자의 영치금품은 다음과 같이 처리한다.",
            "조문번호": "6",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "영치금품의 처리",
            "조문키": "0006001",
            "항": {
              "호": [
                {
                  "호내용": "1. 영치금은 발송관서에서 수송관서에 전자금융을 이용하여 송금한다. 다만, 소액의 금전 또는 당일 호송을 마칠 수 있는 때에는 호송관에게 탁송(託送)할 수 있다.",
                  "호번호": "1."
                },
                {
                  "호내용": "2. 피호송자가 법령에 의하여 호송 중에 물품 등을 자신의 비용으로 구매할 수 있는 때에 그 청구가 있으면 필요한 금액을 호송관에게 탁송하여야 한다.",
                  "호번호": "2."
                },
                {
                  "호내용": "3. 영치품은 호송관에게 탁송한다. 다만, 위험하거나 호송관이 휴대하기 적당하지 아니한 영치품은 발송관서에서 수송관서에 직송(直送)할 수 있다.",
                  "호번호": "3."
                },
                {
                  "호내용": "4. 송치중의 영치금품을 호송관에게 탁송한 때에는 호송관서에 보관책임이 있고, 그러하지 아니한 때에는 발송관서에 보관책임이 있다.",
                  "호번호": "4."
                }
              ]
            }
          },
          {
            "조문내용": "제7조(호송시간) 호송은 일출전 또는 일몰후에는 행할 수 없다. 다만, 열차ㆍ선박ㆍ항공기를 이용하는 때 또는 특별한 사유가 있는 때에는 예외로 한다.",
            "조문번호": "7",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "호송시간",
            "조문키": "0007001"
          },
          {
            "조문내용": "제8조(피호송자의 숙박)",
            "조문번호": "8",
            "조문변경여부": "Y",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "피호송자의 숙박",
            "조문참고자료": "[제목개정 2011.1.4]",
            "조문키": "0008001",
            "항": [
              {
                "항내용": "①피호송자의 숙박은 열차ㆍ선박 및 항공기를 제외하고는 경찰관서 또는 교정시설을 이용하여야 하며, 숙박의뢰를 받은 경찰관서의 장 또는 교정시설의 장은 부득이 한 경우를 제외하고는 이를 거절할 수 없다.",
                "항번호": "①"
              },
              {
                "항내용": "②제1항에 의하기 곤란한 때에는 다른 숙소를 정할 수 있다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제9조(물품구매등의 허가)",
            "조문번호": "9",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "물품구매등의 허가",
            "조문키": "0009001",
            "항": [
              {
                "항내용": "①피호송자가 법령에 의하여 필요한 물품을 자신의 비용으로 구입할 수 있는 때에는 호송관은 물품의 구매를 허가할 수 있다.",
                "항번호": "①"
              },
              {
                "항내용": "②제1항의 구매품의 대가를 제6조제2호의 금전중에서 지출할 때에는 호송관은 본인의 확인서를 받아야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제10조(피호송자의 도주 등)",
            "조문번호": "10",
            "조문변경여부": "N",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "피호송자의 도주 등",
            "조문참고자료": "[제목개정 2011.1.4]",
            "조문키": "0010001",
            "항": [
              {
                "항내용": "①피호송자가 도주한 때에는 호송관은 즉시 그 지방 및 인근 경찰관서와 호송관서에 통지하여야 하며, 호송관서는 관할 지방검찰청, 사건소관 검찰청, 호송을 명령한 관서, 발송관서 및 수송관서에 통지하여야 한다.",
                "항번호": "①"
              },
              {
                "항내용": "②제1항의 경우에는 서류와 금품은 발송관서에 반환하여야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제11조(피호송자의 질병등)",
            "조문번호": "11",
            "조문변경여부": "Y",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "피호송자의 질병등",
            "조문키": "0011001",
            "항": [
              {
                "항내용": "①피호송자가 질병에 걸렸을 때에는 적당한 치료를 하여야 하며, 호송을 계속할 수 없다고 인정한 때에는 피호송자를 그 서류 및 금품과 함께 인근 교정시설 또는 경찰관서에 일시 유치할 수 있다.",
                "항번호": "①"
              },
              {
                "항내용": "② 제1항에 따라 피호송자를 유치한 관서는 피호송자의 치료 등에 적극 협조하여야 한다.",
                "항번호": "②"
              },
              {
                "항내용": "③질병이 치유된 때에는 제1항의 관서는 즉시 호송을 속행하고 발송관서에 통지하여야 한다.",
                "항번호": "③"
              }
            ]
          },
          {
            "조문내용": "제12조(피호송자의 사망 등)",
            "조문번호": "12",
            "조문변경여부": "Y",
            "조문시행일자": "20180220",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "피호송자의 사망 등",
            "조문참고자료": "[전문개정 2011.1.4]",
            "조문키": "0012001",
            "항": [
              {
                "항내용": "① 피호송자가 사망한 경우 호송관서는 사망지 관할 검사의 지휘에 따라 그 인근 경찰관서 또는 교정시설의 협조를 얻어 피호송자의 사망에 따른 업무를 처리한다.",
                "항번호": "①"
              },
              {
                "항내용": "② 피호송자가 열차ㆍ선박 또는 항공기에서 사망한 경우 호송관서는 최초 도착한 곳의 관할 검사의 지휘에 따라 그 인근 경찰관서 또는 교정시설의 협조를 얻어 제1항에 따른 업무를 처리한다.",
                "항번호": "②"
              },
              {
                "항내용": "③ 호송관서는 피호송자가 사망한 즉시 발송관서ㆍ수송관서 및 사망자의 가족(가족이 없는 경우 다른 친족을 말한다. 이하 이 조에서 같다)에게 사망일시, 장소 및 원인 등을 통지하여야 한다.",
                "항번호": "③"
              },
              {
                "항내용": "④ 제3항에 따른 통지를 받을 가족이 없거나, 통지를 받은 가족이 통지를 받은 날부터 3일 내에 그 시신을 인수하지 않으면 임시로 매장하여야 한다.",
                "항번호": "④"
              }
            ]
          },
          {
            "조문내용": "제13조(예비ㆍ호송비용의 부담)",
            "조문번호": "13",
            "조문변경여부": "Y",
