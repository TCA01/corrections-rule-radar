            "항": [
              {
                "항내용": "①피호송자가 도주한 때에는 호송관은 즉시 그 지방 및 인근 경찰관서와 호송관서에 통지하여야 하며, 호송관서는 관할 지방공소청, 사건소관 공소청, 호송을 명령한 관서, 발송관서 및 수송관서에 통지하여야 한다.",
                "항번호": "①"
              },
              {
                "항내용": "②제1항의 경우에는 서류와 금품은 발송관서에 반환하여야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제11조(피호송자의 질병등)",
            "조문번호": "11",
            "조문변경여부": "N",
            "조문시행일자": "20261002",
            "조문여부": "조문",
            "조문이동이전": "",
            "조문이동이후": "",
            "조문제개정유형": "타법개정",
            "조문제목": "피호송자의 질병등",
            "조문키": "0011001",
            "항": [
              {
                "항내용": "①피호송자가 질병에 걸렸을 때에는 적당한 치료를 하여야 하며, 호송을 계속할 수 없다고 인정한 때에는 피호송자를 그 서류 및 금품과 함께 인근 교정시설 또는 경찰관서에 일시 유치할 수 있다.",
                "항번호": "①"
              },
              {
                "항내용": "② 제1항에 따라 피호송자를 유치한 관서는 피호송자의 치료 등에 적극 협조하여야 한다.",
                "항번호": "②"
              },
              {
                "항내용": "③질병이 치유된 때에는 제1항의 관서는 즉시 호송을 계속 진행하고 발송관서에 통지해야 한다.",
                "항번호": "③"
              }
            ]
          },
          {
            "조문내용": "제12조(피호송자의 사망 등)",
            "조문번호": "12",
            "조문변경여부": "N",
            "조문시행일자": "20261002",
            "조문여부": "조문",
            "조문이동이전": "",
            "조문이동이후": "",
            "조문제개정유형": "타법개정",
            "조문제목": "피호송자의 사망 등",
            "조문참고자료": "[전문개정 2011.1.4]",
            "조문키": "0012001",
            "항": [
              {
                "항내용": "① 피호송자가 사망한 경우 호송관서는 사망지 관할 검사의 지휘에 따라 그 인근 경찰관서 또는 교정시설의 협조를 얻어 피호송자의 사망에 따른 업무를 처리한다.",
                "항번호": "①"
              },
              {
                "항내용": "② 피호송자가 열차ㆍ선박 또는 항공기에서 사망한 경우 호송관서는 최초 도착한 곳의 관할 검사의 지휘에 따라 그 인근 경찰관서 또는 교정시설의 협조를 얻어 제1항에 따른 업무를 처리한다.",
                "항번호": "②"
              },
              {
                "항내용": "③ 호송관서는 피호송자가 사망한 즉시 발송관서ㆍ수송관서 및 사망자의 가족(가족이 없는 경우 다른 친족을 말한다. 이하 이 조에서 같다)에게 사망일시, 장소 및 원인 등을 통지하여야 한다.",
                "항번호": "③"
              },
              {
                "항내용": "④ 제3항에 따른 통지를 받을 가족이 없거나, 통지를 받은 가족이 통지를 받은 날부터 3일 내에 그 시신을 인수하지 않으면 임시로 매장하여야 한다.",
                "항번호": "④"
              }
            ]
          },
          {
            "조문내용": "제13조(예비ㆍ호송비용의 부담)",
            "조문번호": "13",
            "조문변경여부": "N",
            "조문시행일자": "20261002",
            "조문여부": "조문",
            "조문이동이전": "",
            "조문이동이후": "",
            "조문제개정유형": "타법개정",
            "조문제목": "예비ㆍ호송비용의 부담",
            "조문키": "0013001",
            "항": [
              {
                "항내용": "①호송관의 여비나 피호송자의 호송비용은 호송관서가 부담한다. 다만, 피호송자를 교정시설이나 경찰관서에 숙식하게 한 때에는 그 비용은 교정시설이나 경찰관서가 부담한다.",
                "항번호": "①"
              },
              {
                "항내용": "②제11조와 제12조에 의한 비용은 각각 그 교부를 받은 관서가 부담한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제14조(호송비용) 피호송자를 교정시설이나 경찰관서가 아닌 장소에서 숙식하게 한 때의 비용은 「공무원 여비 규정」 제30조 및 별표 9 제5호를 준용한다.",
            "조문번호": "14",
