      "articles": {
        "조문단위": [
          {
            "조문내용": "제1조(목적) 이 규칙은 「공무원임용시험령」 제3조 및 제5조제4항에 따라 교정직공무원 임용을 위하여 법무부장관이 실시하는 실기시험으로서 체력검사의 시행에 필요한 사항을 규정함을 목적으로 한다.",
            "조문번호": "1",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "목적",
            "조문키": "0001001"
          },
          {
            "조문내용": "제2조(체력검사의 대상 등) 직무수행에 필요한 체력을 검정하기 위한 실기시험으로서 체력검사의 대상은 다음 각 호의 어느 하나와 같다.",
            "조문번호": "2",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "체력검사의 대상 등",
            "조문키": "0002001",
            "항": {
              "호": [
                {
                  "호내용": "1. 법무부장관이 실시하는 교정직류 6급 이하 공무원의 채용시험과 전직(轉職)시험",
                  "호번호": "1."
                },
                {
                  "호내용": "2. 「공무원임용시험령」 제3조제3항에 따라 인사혁신처장과 공동으로 또는 인사혁신처장의 위탁을 받아 법무부장관이 실시하는 교정직류 6급 이하 공무원의 공개경쟁채용시험",
                  "호번호": "2."
                }
              ]
            }
          },
          {
            "조문내용": "제3조(체력검사의 종목 및 합격기준 등)",
            "조문번호": "3",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "체력검사의 종목 및 합격기준 등",
            "조문키": "0003001",
            "항": [
              {
                "항내용": "① 「공무원임용시험령」 제24조제4항, 제29조제5항 및 제37조제2항에 따른 체력검사의 종목 및 합격기준 등은 별표와 같다.",
                "항번호": "①"
              },
              {
                "항내용": "② 체력검사 결과는 별지 서식의 체력검사 판정표에 기록하고 즉석에서 응시자에게 알려야 한다.",
                "항번호": "②"
              }
            ]
          }
        ]
      }
    },
