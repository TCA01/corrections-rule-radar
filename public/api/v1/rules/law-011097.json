      "articles": {
        "조문단위": [
          {
            "조문내용": "제1조(목적) 이 규칙은 「교도작업의 운영 및 특별회계에 관한 법률」 및 「교도작업의 운영 및 특별회계에 관한 법률 시행령」에서 위임된 사항과 그 시행에 필요한 사항을 규정함을 목적으로 한다.",
            "조문번호": "1",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "목적",
            "조문키": "0001001"
          },
          {
            "조문내용": "제2조(다른 법령과의 관계) 「교도작업의 운영 및 특별회계에 관한 법률」(이하 \"법\"이라 한다)에 따른 교도작업의 운영 및 교도작업특별회계(이하 \"특별회계\"라 한다)에 관하여 다른 법령에 특별한 규정이 있는 경우를 제외하고는 이 규칙에서 정하는 바에 따른다.",
            "조문번호": "2",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "다른 법령과의 관계",
            "조문키": "0002001"
          },
          {
            "조문내용": "제3조(생산공급계획의 보고) 교정시설의 장(이하 \"소장\"이라 한다)이 「교도작업의 운영 및 특별회계에 관한 법률 시행령」(이하 \"영\"이라 한다) 제3조에 따라 법무부장관에게 보고하는 다음 연도의 생산공급계획서에는 다음 각 호의 사항이 포함되어야 한다.",
            "조문번호": "3",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "생산공급계획의 보고",
            "조문키": "0003001",
            "항": {
              "호": [
                {
                  "호내용": "1. 교정시설의 생산 가능량",
                  "호번호": "1."
                },
                {
                  "호내용": "2. 교정시설의 자체 수요량",
                  "호번호": "2."
                },
                {
                  "호내용": "3. 해당 연도 수요기관의 수 및 수요량",
                  "호번호": "3."
                },
                {
                  "호내용": "4. 해당 지역의 생산실태와 수요량",
                  "호번호": "4."
                },
                {
                  "호내용": "5. 생산공급계획량",
                  "호번호": "5."
                },
                {
                  "호내용": "6. 그 밖에 교도작업제품의 생산과 관련하여 필요한 사항",
                  "호번호": "6."
                }
              ]
            }
          },
          {
            "조문내용": "제4조(교도작업 참여 신청 등)",
            "조문번호": "4",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "교도작업 참여 신청 등",
            "조문키": "0004001",
            "항": [
              {
                "항내용": "① 법 제6조제1항에 따라 교도작업에 참여하려는 민간기업은 별지 서식의 참여신청서를 법무부장관에게 제출하여야 한다.",
                "항번호": "①"
              },
              {
                "항내용": "② 교도작업에 참여하려는 민간기업은 경영상태가 양호하고, 취업지원을 하는 등 수형자의 사회복귀에 도움이 될 수 있어야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제5조(단기계약)",
            "조문번호": "5",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "단기계약",
            "조문키": "0005001",
            "항": [
              {
                "항내용": "① 법 제6조제2항 단서에서 \"법무부장관이 정하는 단기의 계약\"이란 계약기간이 2개월 이하인 계약을 말한다.",
                "항번호": "①"
              },
              {
                "항내용": "② 소장은 제1항에 따른 계약을 체결한 경우에는 지체 없이 법무부장관에게 보고하여야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제6조(교도작업의 종류)",
            "조문번호": "6",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "교도작업의 종류",
            "조문키": "0006001",
            "항": [
              {
                "항내용": "① 영 제6조에 따른 교도작업의 종류는 다음  각 호와 같다",
                "항번호": "①",
                "호": [
                  {
                    "호내용": "1. 직영작업: 법 제6조에 따른 민간기업의 참여 없이 교도작업제품을 생산하는 작업",
                    "호번호": "1."
                  },
                  {
                    "호내용": "2. 위탁작업: 법 제6조에 따라 교도작업에 참여한 민간기업을 통하여 교도작업제품을 생산하는 작업",
                    "호번호": "2."
                  },
                  {
                    "호내용": "3. 노무작업: 수용자의 노무를 제공하여 교도작업제품을 생산하는 작업",
                    "호번호": "3."
                  },
                  {
                    "호내용": "4. 도급작업: 국가와 제3자 간의 공사 도급계약에 따라 수용자에게 부과하는 작업",
                    "호번호": "4."
                  }
                ]
              },
              {
                "항내용": "② 소장은 제1항에 따른 작업을 중지하려면 지방교정청장의 승인을 받아야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제7조(계약서 작성요령) 특별회계의 세입ㆍ세출의 원인이 되는 계약을 담당하는 공무원(이하 \"계약담당자\"라 한다)은 계약서를 작성할 때에는 다음 각 호의 사항을 유의하여야 한다.",
            "조문번호": "7",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "계약서 작성요령",
            "조문키": "0007001",
            "항": {
              "호": [
                {
                  "호내용": "1. 계약의 목적은 그 내용을 구성하는 품명ㆍ산지(産地)ㆍ규격ㆍ형상ㆍ수량ㆍ단가 및 금액을 구체적으로 적을 것",
                  "호번호": "1."
                },
                {
                  "호내용": "2. 이행 기한은 해당 회계연도로 하되, 이행의 난이도, 수량의 많고 적음, 계절 및 시장의 상황, 그 밖의 여건 및 자금사정을 고려하여 사업 운영에 적합하도록 할 것",
                  "호번호": "2."
                },
                {
                  "호내용": "3. 이행 장소는 계약금액을 고려하여 결정한 후 계약서 본문에 명시할 것",
                  "호번호": "3."
                },
                {
                  "호내용": "4. 계약서는 계약서ㆍ명세서ㆍ예정가격조서ㆍ설계사양서ㆍ도면ㆍ설계설명서ㆍ주의서ㆍ입찰서ㆍ입찰단가명세서, 그 밖의 부속서류 순으로 철하여 양쪽 당사자가 간인(間印)하고 이를 계약서의 원본으로 할 것",
                  "호번호": "4."
                }
              ]
            }
          },
          {
            "조문내용": "제8조(낙찰가격과 예정가격 명세의 재조정) 계약의 목적을 구성하는 내용이 두 종류 이상일 경우에는 낙찰자 또는 계약의 상대방으로 하여금 낙찰총액에 부합되는 명세서를 제출하게 하여, 그 명세서상 금액과 예정가격의 명세금액을 낙찰액과 예정가격과의 비율에 해당하는 금액의 범위 내로 조정한 금액을 계약금액의 명세로 하여야 한다.",
            "조문번호": "8",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "낙찰가격과 예정가격 명세의 재조정",
            "조문키": "0008001"
          },
          {
            "조문내용": "제9조(수의계약의 절차)",
            "조문번호": "9",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "수의계약의 절차",
            "조문키": "0009001",
            "항": [
              {
                "항내용": "① 계약담당자는 계약을 수의계약으로 하려면 「교도관직무규칙」 제21조에 따른 교도관회의의 심의를 거쳐야 한다.",
                "항번호": "①"
              },
              {
                "항내용": "② 계약담당자가 계약을 수의계약으로 한 경우에는 법무부장관에게 보고하여야 한다.",
                "항번호": "②"
              }
            ]
          },
          {
            "조문내용": "제10조(계약불이행) 계약담당자는 상대방의 계약불이행으로 인한 손해배상금ㆍ지체상금(遲滯償金) 또는 계약보증금 등을 지출액과 상계(相計)하여야 할 때에는 그 관계 서류와 산출계산명세서를 관계 지출관 또는 출납공무원에게 제출하여야 한다.",
            "조문번호": "10",
            "조문변경여부": "N",
            "조문시행일자": "20151125",
            "조문여부": "조문",
            "조문이동이전": "000000",
            "조문이동이후": "000000",
            "조문제개정유형": "일부개정",
            "조문제목": "계약불이행",
            "조문키": "0010001"
          }
        ]
      }
    },
